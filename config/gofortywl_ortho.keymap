#include <behaviors.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <behaviors/runtime_tap_dance.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/* --- 標準の &mt (Mod-Tap) は「長押し：タイピング優先」 ---
   ZMK の &mt は flavor = "hold-preferred" で、押している間に別のキーが
   押された瞬間にホールドと決まる。Z に Shift を重ねると「醸造 (zyouzou)」を
   速く打ったときに z と y、z と o の押下が重なり、Shift+y / Shift+o に
   なって「YouOu」と入力されていた。

   tap-preferred は、判定時間 (200ms) が過ぎるまで押し続けたときだけ
   ホールドになる。その前に離せば、別のキーと重なっていてもタップ。
   QMK の既定 (PERMISSIVE_HOLD も HOLD_ON_OTHER_KEY_PRESS も無し) と同じ。
   単語の頭の z (直前に間が空いている) もこれで直る。

   require-prior-idle-ms は、直前のキーから 150ms 以内に押されたら
   その場でタップと決める。単語の途中の z は判定を待たずに出るので、
   速く打っているときの引っかかりが無くなる。代わりに、速く打っている
   途中で Z を Shift として使うと z が出る。

   ゆっくり Z を押し続ければ Shift。200ms 経つ前に押した別のキーにも、
   Z を 200ms 押し続けていれば Shift が付く (押下は判定まで保留される)。

   従来の &mt と同じ動作は下の mt_mid (Mod-Tap 200ms)。ノード名は変えて
   いないので、「Mod-Tap」を割り当て済みのキーはそのまま新しい判定になる。 */
&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    require-prior-idle-ms = <150>;
};

/ {
    behaviors {
        /* --- タップ/ホールドの判定時間プリセット ---
           押している時間がここで指定した ms を超えたら「ホールド」、
           それより短ければ「タップ」と判定される。
           数値ちがいのインスタンスを並べて定義しておくと、Keeb-On! Studio の
           キー割り当て候補にそのまま並び、キーごとに好みの速さを選べる。
           値そのものはコンパイル時固定だが、ファームウェアはタグを打てば
           GitHub Releases から配布されるので、合わなければ数値を変えて再配布する。

           flavor は ZMK の標準に合わせてある:
             mod-tap 系   = hold-preferred (ZMK 本来の &mt と同じ)
             layer-tap 系 = tap-preferred  (ZMK の &lt と同じ)
           lt_mid は標準の &lt と完全に同じ挙動。mt_mid は ZMK 本来の &mt と
           同じ挙動で、このファイルの先頭で tap-preferred に上書きしている
           &mt とは違う (mt_mid が「長押し：反応優先」の 200ms)。 */

        mt_fast: mod_tap_fast {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <150>;
            bindings = <&kp>, <&kp>;
            display-name = "Mod-Tap 150ms";
        };

        mt_mid: mod_tap_mid {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
            display-name = "Mod-Tap 200ms";
        };

        mt_slow: mod_tap_slow {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <280>;
            bindings = <&kp>, <&kp>;
            display-name = "Mod-Tap 280ms";
        };

        lt_fast: layer_tap_fast {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&mo>, <&kp>;
            display-name = "Layer-Tap 150ms";
        };

        lt_mid: layer_tap_mid {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
            display-name = "Layer-Tap 200ms";
        };

        lt_slow: layer_tap_slow {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <280>;
            bindings = <&mo>, <&kp>;
            display-name = "Layer-Tap 280ms";
        };

        /* --- QMK の PERMISSIVE_HOLD 相当 ---
           QMK の PERMISSIVE_HOLD は「押している間に別のキーが押されて
           *離された* なら、TAPPING_TERM を待たずにホールドと決める」。
           ZMK ではこれが flavor = "balanced"。上の hold-preferred は
           QMK でいう HOLD_ON_OTHER_KEY_PRESS(別キーが押された時点で
           ホールド確定)で、もっと強い。tap-preferred はその逆側。

           時間は QMK 側で使っていた TAPPING_TERM 180 に合わせてある。

           QUICK_TAP_TERM 0 に相当する設定は書いていない。ZMK の
           quick-tap-ms は既定が -1 = 無効で、これが QMK の 0 と同じ意味。
           値を書くとむしろ有効になってしまう。

           ClickBoard ErgoTrack と同じ 2 つ。名前(display-name)も同じに
           してある: Keeb-On! Studio は末尾の「<数値>ms」と括弧の中身で
           プリセットを見分ける。 */
        mt_perm: mod_tap_perm {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            bindings = <&kp>, <&kp>;
            display-name = "Mod-Tap 180ms (Permissive)";
        };

        lt_perm: layer_tap_perm {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            bindings = <&mo>, <&kp>;
            display-name = "Layer-Tap 180ms (Permissive)";
        };

        /* --- 長押しの判定方式を 200ms で揃えた 3 択 ---
           Keeb-On! Studio でキーごとに選べるようにする。時間は全部 200ms で、
           違うのは「押している間に別のキーが押されたとき」の扱いだけ。

                           Mod-Tap            Layer-Tap
             タイピング優先  &mt (上書き)       &lt (標準のまま)
             バランス        mt_bal             lt_bal
             反応優先        mt_mid             lt_hold

           タイピング優先 (tap-preferred): 判定時間まで押し続けたときだけ
             ホールド。文字キーに修飾キーを重ねるならこれ。
           バランス (balanced): 押している間に別のキーを押して離したら
             ホールド。QMK の PERMISSIVE_HOLD。
           反応優先 (hold-preferred): 押している間に別のキーを押した時点で
             ホールド。QMK の HOLD_ON_OTHER_KEY_PRESS。

           &lt に require-prior-idle-ms は付けない。文字を打った直後に
           親指のレイヤーキーを押してカーソルを動かす、という使い方が
           スペースの入力に化けるため。

           display-name は「<名前> <数値>ms (<方式>)」の形を守る。アプリは
           この形で Mod-Tap / Layer-Tap の仲間だと判定し、括弧の中身から
           判定方式の表示名と説明を付ける。Mod-Tap 200ms (Balanced) が
           あることは、アプリが「このファームの &mt はタイピング優先」と
           判断する目印でもある (判定方式は通信では見えない)。
           ノード名は保存済みキーマップがビヘイビアを覚える名前なので、
           一度出したら変えないこと。 */
        mt_bal: mod_tap_balanced {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
            display-name = "Mod-Tap 200ms (Balanced)";
        };

        lt_bal: layer_tap_balanced {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
            display-name = "Layer-Tap 200ms (Balanced)";
        };

        lt_hold: layer_tap_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
            display-name = "Layer-Tap 200ms (Hold-preferred)";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            // Layer 0: o51go の Remap キーマップと同一構成(BTキー2個の追加のみ)

            bindings = <
&bt BT_PRV  &bt BT_NXT  &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp LBRC  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp DEL  &kp LCTRL  &kp A  &kp S  &kp D  &kp F  &kp G  &kp SEMI  &kp H  &kp J  &kp K  &kp L  &kp MINUS  &kp RET  &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp MINUS  &kp N  &kp M  &kp COMMA  &kp DOT  &kp UP  &lt_mid 2 INT_RO  &kp LANG1  &mt_mid LGUI LANG2  &kp LALT  &mt_mid LEFT_WIN INT_MUHENKAN  &lt_mid 3 RET  &kp BSPC  &kp DELETE  &lt_mid 2 SPACE  &mt_mid LALT INT_HENKAN  &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        alt_base_layer {
            display-name = "Alt Base";
            // Layer 1: もう一方のOS用のベース。OS検出がデフォルトレイヤーを
            // 0 と 1 で切り替える (CONFIG_ZMK_DEFAULT_LAYER_OS_DETECTION)。
            //
            // ここが「デフォルトレイヤー」になったときは、これより下の
            // レイヤーは参照されない: zmk_keymap_position_state_changed() の
            // 走査はデフォルトレイヤーで止まる。つまり &trans のままだと
            // 切り替えた瞬間に全キーが無反応になる。
            // Keeb-On! Studio の「Baseからコピー」で埋めてから使うこと。
            //
            // 位置は 1 でなければならない。&lt_mid で押さえるレイヤーは
            // デフォルトより上(番号が大きい)である必要があるため、
            // ここに割り込ませて既存のレイヤーを1つずつ繰り下げてある。

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer2 {
            // Layer 2: 空。ビルド後に Keeb-On! Studio から自由に割り当てる。
            //
            // 先頭キーは一時期 &studio_unlock だった。Studio のロックをやめた
            // ので不要になり、外してある。経緯は .conf に書いた。

            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };

        layer3 {
            // Layer 3: 空。ZMK Studioから割り当てる。

            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };

        layer4 {
            // Layer 4: 空。ZMK Studioから割り当てる。

            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };

        /* Keeb-On! Studio から足せる空きレイヤー枠。基本 5 + 予備 11 = 16 層
         * (ClickBoard ErgoTrack と同じ上限)。予備は書き換えたぶんだけ保存領域を
         * 使うので、たくさん使うときはアプリの「設定の保存領域」を見る。
         * ZMK の上限は 32(レイヤー状態が 32 ビット)。 */
        extra1 { status = "reserved"; };
        extra2 { status = "reserved"; };
        extra3 { status = "reserved"; };
        extra4 { status = "reserved"; };
        extra5 { status = "reserved"; };
        extra6 { status = "reserved"; };
        extra7 { status = "reserved"; };
        extra8 { status = "reserved"; };
        extra9 { status = "reserved"; };
        extra10 { status = "reserved"; };
        extra11 { status = "reserved"; };
    };
};
